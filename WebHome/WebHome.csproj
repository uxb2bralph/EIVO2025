<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RazorCompileOnPublish>true</RazorCompileOnPublish>
	<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Use the explicit npm/tsconfig build hook below instead of legacy MSBuild TypeScript compilation. -->
    <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="Views\AshxHelper\DumpExceptionLog.cshtml" />
    <Content Remove="Views\AshxHelper\GetSample.cshtml" />
    <Content Remove="Views\InvoiceBusiness\Module\InvoiceCreated.cshtml" />
    <Content Remove="wwwroot\ts\index.ts" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Properties\launchSettings.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- <Folder Include="wwwroot\" /> -->
    <Folder Include="Views\DonatedInvoice\Module\" />
    <Folder Include="Views\InvoiceProcess\Buyer\" />
    <Folder Include="Views\Module\" />
    <Folder Include="Views\TestAll\" />
    <Folder Include="Views\WinningNumber\ScriptHelper\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Views\AshxHelper\DumpExceptionLog.cshtml" />
    <None Include="Views\AshxHelper\GetSample.cshtml" />
    <None Include="Views\InvoiceBusiness\Module\InvoiceCreated.cshtml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CoreWCF.Http" Version="1.8.0" />
    <PackageReference Include="CoreWCF.Primitives" Version="1.8.0" />
    <PackageReference Include="GoogleAuthenticator" Version="3.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.5" />
    <PackageReference Include="Microsoft.TypeScript.MSBuild" Version="5.9.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.1" />
    <PackageReference Include="System.Security.Cryptography.Csp" Version="4.3.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.14" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApplicationResource\ApplicationResource.csproj" />
    <ProjectReference Include="..\Business.EF\Business.EF.csproj" />
    <ProjectReference Include="..\CommonLib.Core\CommonLib.Core.csproj" />
    <ProjectReference Include="..\ExternalPdfWrapper\ExternalPdfWrapper.csproj" />
    <ProjectReference Include="..\JobHelper\JobHelper.csproj" />
    <ProjectReference Include="..\ModelCore.EF\ModelCore.EF.csproj" />
    <ProjectReference Include="..\ModelExtension.EF\ModelExtension.EF.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MessagingToolkit.QRCode">
      <HintPath>bin\Dependencies\Lib\MessagingToolkit.QRCode.dll</HintPath>
    </Reference>
    <Reference Include="QREncrypter">
      <HintPath>bin\Dependencies\Lib\QREncrypter.dll</HintPath>
    </Reference>
    <Reference Include="ThoughtWorks.QRCode">
      <HintPath>bin\Dependencies\Lib\ThoughtWorks.QRCode.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- TypeScript / frontend tooling support -->
  <ItemGroup>
    <None Include="package.json" />
    <None Include="tsconfig.json" />
    <None Include="wwwroot\ts\**\*.ts" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="wwwroot\ts\index.ts" />
  </ItemGroup>
  <!--
    Optional TypeScript build hook. To enable automatic TypeScript build during MSBuild,
    invoke msbuild with -p:TypeScriptBuild=true or set the property in your IDE.
    This keeps the default build unchanged unless you explicitly enable it.
  -->
  <Target Name="BuildTypeScript" BeforeTargets="Build" Condition="'$(TypeScriptBuild)'=='true'">
    <!-- Run npm install (only once per machine/project) -->
    <Message Importance="high" Text="TypeScript build enabled: running npm install..." />
    <Exec Command="npm install" WorkingDirectory="$(ProjectDir)" />

    <!-- Run TypeScript compilation using package.json scripts -->
    <Message Importance="high" Text="Running npm run build:ts" />
    <Exec Command="npm run build:ts" WorkingDirectory="$(ProjectDir)" />
  </Target>

</Project>
