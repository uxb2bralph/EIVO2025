{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "outDir": "wwwroot/js",
    "rootDir": "wwwroot/ts",
    "sourceMap": true,
    "inlineSources": false,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"]
  },
  "include": ["wwwroot/ts/**/*"]
}
