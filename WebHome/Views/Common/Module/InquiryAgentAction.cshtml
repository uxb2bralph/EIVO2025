
@using System.IO
@using System.Linq.Expressions

@using WebHome.Models
@using ModelCore.DataEntity
@using ModelCore.Helper
@using ModelCore.Locale
@using CommonLib.Core.Utility
@using CommonLib.Utility
@using Microsoft.AspNetCore.Mvc.ModelBinding
@using Microsoft.AspNetCore.Mvc.Razor

@using WebHome.Controllers
@using WebHome.Helper
@using ModelCore.Models.ViewModel
@{
    Layout = "~/Views/Common/Module/InquiryAgentActionTemplate.cshtml";
    ModelStateDictionary _modelState;
    ModelSource<InvoiceItem> models;

    models = (ModelSource<InvoiceItem>)ViewContext.HttpContext.Items["Models"]!;
    _modelState = (ModelStateDictionary)ViewBag.ModelState;
    QueryViewModel _viewModel = ViewBag.ViewModel as QueryViewModel ?? new QueryViewModel { };

}

@section PrepareAgent
{
    <script>
        $inquiryAgent.viewModel = @Html.Raw(_viewModel.JsonStringify());
        $inquiryAgent.viewModel.Paging = @(_viewModel.Paging==false ? "false" : "true");
        $inquiryAgent.inquiryAction = '@Html.Raw(_viewModel.UrlAction)';
        $inquiryAgent.deleteAction = '@Html.Raw(_viewModel.DeleteAction)';
        $inquiryAgent.loadAction = '@Html.Raw(_viewModel.LoadAction)';
        $inquiryAgent.editAction = '@Html.Raw(_viewModel.EditAction)';
        $inquiryAgent.commitAction = '@Html.Raw(_viewModel.CommitAction)';
        $inquiryAgent.downloadAction = '@Html.Raw(_viewModel.DownloadAction)';
    </script>
}
