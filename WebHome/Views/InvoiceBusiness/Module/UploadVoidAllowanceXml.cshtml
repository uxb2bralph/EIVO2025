
@using System.IO
@using System.Linq.Expressions


@using WebHome.Helper
@using ModelCore.Locale
@using WebHome.Models.ViewModel
@using ModelCore.Models.ViewModel
@using ModelCore.DataEntity
@using ModelCore.Security.MembershipManagement

@using ModelCore.Helper
@using WebHome.Controllers
@{

    InvoiceViewModel _viewModel;

    _viewModel = (InvoiceViewModel)ViewBag.ViewModel;
    UserProfileWrapper _profile = Context.GetUser();
}

    <tr>
        <th>
            作廢折讓單(Xml)
        </th>
        <td class="tdleft">
            <input type="button" name="btnVoidAllowanceXmlSample" value="下載範本" />&nbsp;&nbsp;
            <input type="button" name="btnImportVoidAllowanceXml" value="立即傳送" />
            <script>
                        $(function () {

                            $('input[name="btnVoidAllowanceXmlSample"]').on('click', function (event) {
                                $('').launchDownload('@Html.Raw(Url.Action("GetVoidAllowanceRequestXmlSample","InvoiceBusiness"))', {});
                            });

                            var $btn = $('input[name="btnImportVoidAllowanceXml"]');
                            var $file = $('<input name="theFile" type="file" accept=".xml" style="display: none;" />');
                            $btn.before($file);

                            $btn.click(function () {
                                $file.val('');
                                $file.click();
                            });

                            $file.on('change', function (event) {
                                clearErrors();
                                var $formData = $('form').find('input,select,textArea').serializeObject();
                                uploadFile($file, $formData, '@Html.Raw($"{ModelExtension.Properties.AppSettings.Default.TaskCenterUrl}/InvoiceData/UploadVoidAllowanceRequestXml?sender={_profile.Entity.UID}")',
                                    function (data) {
                                        $btn.before($file);
                                        if ($.isPlainObject(data)) {
                                            if (data.result) {
                                                alert('開立資料傳送完成，請至工作提示區檢視處理狀態。');
                                            } else {
                                                reportError(data);
                                            }
                                        }
                                    },
                                    function () {
                                        $btn.before($file);
                                    });
                            });
                        });
            </script>
        </td>
    </tr>

