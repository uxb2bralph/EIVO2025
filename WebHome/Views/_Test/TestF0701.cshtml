@using System.IO
@using System.Linq.Expressions
@using System.Web
@using WebHome.Helper
@using ModelCore.Locale
@using WebHome.Models.ViewModel
@using ModelCore.Models.ViewModel
@using ModelCore.DataEntity
@using ModelCore.Helper
@using WebHome.Controllers
@using CommonLib.Core.Utility
@using CommonLib.Utility
@using Microsoft.AspNetCore.Mvc.ModelBinding
@using Microsoft.AspNetCore.Mvc.Razor
@using WebHome.Infrastructure.BackgroundTasks

@{
    _modelState = (ModelStateDictionary)ViewBag.ModelState;
    models = (ModelSource<InvoiceItem>)ViewContext.HttpContext.Items["Models"]!;

    doTask();
}

<!DOCTYPE html>
<html>
<head runat="server">
    <title></title>
</head>
<body>
    <form method="post" enctype="multipart/form-data">
        <div>F0401:@(ModelExtension.Properties.AppSettings.Default.F0401Outbound)</div>
        <div>F0701:@(ModelExtension.Properties.AppSettings.Default.F0701Outbound)</div>
        <div>
            Invoice No:
            <textarea cols="80" rows="10" name="invoiceNo">@(_viewModel?.InvoiceNo)</textarea><br />
            EndNo No: <input type="text" name="endNo" value="@(_viewModel?.EndNo)" />
            Invoice No CSV:
            <input type="file" name="CsvFile" />
            <button ID="btnCreate" type="submit">OK!!</button>
        </div>
        <br />
        F0401:
        <textarea cols="80" rows="10">@(_item!=null ? _item.OuterXml : null)</textarea>
        <br />
        F0701:
        <textarea cols="80" rows="10">@(_voidItem!=null ? _voidItem.OuterXml : null)</textarea>
    </form>
</body>
</html>
@functions
{

    protected System.Xml.XmlDocument _item;
    protected System.Xml.XmlDocument _voidItem;
    ModelStateDictionary _modelState;
    ModelSource<InvoiceItem> models;
    InquireInvoiceViewModel _viewModel;

    void doTask()
    {
        models = new ModelSource<InvoiceItem>();

        _viewModel = ViewBag.ViewModel as InquireInvoiceViewModel;
        if (_viewModel == null)
        {
            var t = ((SampleController<InvoiceItem>)ViewContext.HttpContext.Items["Controller"]).PrepareViewModelAsync<InquireInvoiceViewModel>();
            t.Wait();
            _viewModel = t.Result;
        }

        String invoiceNo = _viewModel.InvoiceNo.GetEfficientString();
        String endNo = _viewModel.EndNo.GetEfficientString();

        String storedPath = ModelExtension.Properties.AppSettings.Default.F0401Outbound;
        storedPath.CheckStoredPath();

        IQueryable<InvoiceItem> invoiceItems = models.GetTable<InvoiceItem>();

        if (_viewModel.DateFrom.HasValue)
        {
            invoiceItems = invoiceItems.Where(i => i.InvoiceDate >= _viewModel.DateFrom);
        }

        if (_viewModel.DateTo.HasValue)
        {
            invoiceItems = invoiceItems.Where(i => i.InvoiceDate < _viewModel.DateTo.Value.AddDays(1));
        }

        if (_viewModel.CsvFile != null && _viewModel.CsvFile.Length > 0)
        {
            using (var reader = new StreamReader(_viewModel.CsvFile.OpenReadStream()))
            {
                String csvContent = reader.ReadToEnd();
                String[] items = csvContent.Split(new String[] { "\r\n", ",", ";", "、" }, StringSplitOptions.RemoveEmptyEntries);
                DateTime? dateFrom = _viewModel.DateFrom;
                DateTime? dateTo = _viewModel.DateTo;
                Context.EnqueueBackgroundWork("_Test/TestF0701(csv)",
                    _ => storedMIGByNumbers(dateFrom, dateTo, items));
                alert($"送出執行註銷筆數:{items.Length}");
            }
            models.Dispose();
        }
        else if (endNo == null)
        {
            if (invoiceNo?.Length == 10)
            {
                var item = invoiceItems
                    .Where(i => i.TrackCode == invoiceNo.Substring(0, 2)
                        && i.No == invoiceNo.Substring(2))
                    .OrderByDescending(i => i.InvoiceID)
                    .FirstOrDefault();
                if (item != null)
                {
                    _item = item.CreateF0401();
                    _voidItem = item.CreateF0701();
                }
            }
            else if (invoiceNo != null)
            {
                String[] items = invoiceNo.Split(new String[] { "\r\n", ",", ";", "、" }, StringSplitOptions.RemoveEmptyEntries);

                foreach (var invNo in items)
                {
                    if (invNo.Length != 10)
                        break;
                    var item = invoiceItems
                        .Where(i => i.TrackCode == invNo.Substring(0, 2)
                            && i.No == invNo.Substring(2))
                        .OrderByDescending(i => i.InvoiceID)
                        .FirstOrDefault();
                    if (item != null)
                    {
                        storedMIG(item);
                    }
                }
            }

            models.Dispose();
        }
        else if (invoiceNo.Length == 10 && endNo.Length == 10)
        {
            var items = invoiceItems
                .Where(i => i.TrackCode == invoiceNo.Substring(0, 2))
                .Where(i => String.Compare(i.No, invoiceNo.Substring(2)) >= 0)
                .Where(i => String.Compare(i.No, endNo.Substring(2)) <= 0);

            var count = items.Count();
            if (count > 0)
            {
                alert("送出執行註銷筆數:" + count);
                DateTime? dateFrom = _viewModel.DateFrom;
                DateTime? dateTo = _viewModel.DateTo;
                String trackCode = invoiceNo.Substring(0, 2);
                String startNo = invoiceNo.Substring(2);
                String endNoValue = endNo.Substring(2);
                Context.EnqueueBackgroundWork("_Test/TestF0701(range)",
                    _ => storedMIGByRange(dateFrom, dateTo, trackCode, startNo, endNoValue));
            }
            models.Dispose();
        }
        else
        {
            models.Dispose();
        }
    }

    //以下為背景作業：由 BackgroundTaskService 於請求結束後執行，
    //只帶入純值參數，內部自建 ModelSource 重新查詢，不沿用請求的 models。
    static IQueryable<InvoiceItem> buildInvoiceQuery(ModelSource<InvoiceItem> db, DateTime? dateFrom, DateTime? dateTo)
    {
        IQueryable<InvoiceItem> invoiceItems = db.GetTable<InvoiceItem>();

        if (dateFrom.HasValue)
        {
            invoiceItems = invoiceItems.Where(i => i.InvoiceDate >= dateFrom);
        }

        if (dateTo.HasValue)
        {
            invoiceItems = invoiceItems.Where(i => i.InvoiceDate < dateTo.Value.AddDays(1));
        }

        return invoiceItems;
    }

    static void storedMIGByNumbers(DateTime? dateFrom, DateTime? dateTo, String[] invoiceNumbers)
    {
        using ModelSource<InvoiceItem> db = new ModelSource<InvoiceItem>();
        IQueryable<InvoiceItem> invoiceItems = buildInvoiceQuery(db, dateFrom, dateTo);

        foreach (var invNo in invoiceNumbers)
        {
            if (invNo.Length != 10)
                continue;

            String track = invNo.Substring(0, 2);
            String no = invNo.Substring(2);
            var item = invoiceItems
                .Where(i => i.TrackCode == track && i.No == no)
                .OrderByDescending(i => i.InvoiceID)
                .FirstOrDefault();
            if (item != null)
            {
                storedMIG(item);
            }
        }
    }

    static void storedMIGByRange(DateTime? dateFrom, DateTime? dateTo, String trackCode, String startNo, String endNo)
    {
        using ModelSource<InvoiceItem> db = new ModelSource<InvoiceItem>();

        foreach (var item in buildInvoiceQuery(db, dateFrom, dateTo)
            .Where(i => i.TrackCode == trackCode)
            .Where(i => String.Compare(i.No, startNo) >= 0)
            .Where(i => String.Compare(i.No, endNo) <= 0)
            .ToList())
        {
            try
            {
                storedMIG(item);
            }
            catch (Exception ex)
            {
                Logger.Error(ex);
            }
        }
    }

    static void storedMIG(InvoiceItem item)
    {
        String invoiceNo = item.TrackCode + item.No;
        // lock (typeof(InvoiceProcessController))
        // {
        //     models!.ProcessVoidInvoiceRequest(null, null, item);
        // }
        item.CreateF0701().Save(System.IO.Path.Combine(ModelExtension.Properties.AppSettings.Default.F0701Outbound, "F0701_" + invoiceNo + ".xml"));
    }


}

@functions
{
    void alert(String data)
    {
        <script>
            alert('@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(data))');
        </script>
    }
}
