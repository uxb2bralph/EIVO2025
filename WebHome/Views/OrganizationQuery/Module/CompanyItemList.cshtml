@using System.IO
@using System.Linq.Expressions



@using WebHome.Helper
@using WebHome.Models
@using WebHome.Controllers
@using WebHome.Models.ViewModel
@using ModelCore.DataEntity
@using ModelCore.Helper
@using ModelCore.Locale
@using ModelCore.Security.MembershipManagement
@using ModelCore.Models.ViewModel
@using CommonLib.Core.Utility
@using CommonLib.Utility
@using Microsoft.AspNetCore.Mvc.ModelBinding
@using Microsoft.AspNetCore.Mvc.Razor
@using Microsoft.EntityFrameworkCore

@using Newtonsoft.Json
@functions
{
    ModelStateDictionary _modelState;
    ModelSource<InvoiceItem> models;
    IQueryable<Organization> _model;
    QueryViewModel _viewModel;
}
@{
    models = (ModelSource<InvoiceItem>)ViewContext.HttpContext.Items["Models"]!;
    _modelState = (ModelStateDictionary)ViewBag.ModelState;
    _viewModel = (QueryViewModel)ViewBag.ViewModel;

    _model = (IQueryable<Organization>)this.Model;

    await Html.RenderPartialAsync("~/Views/OrganizationQuery/Module/CompanyItemSorting.cshtml");

    int pageIndex = _viewModel.PageIndex ?? 0;
    int pageSize = _viewModel.PageSize ?? 10;

    IQueryable<Organization> source = (TempData["SortedItems"] as IQueryable<Organization>) ?? _model;

    source = source
        .Include(o => o.OrganizationStatus!)
            .ThenInclude(s => s.CurrentLevelNavigation)
        .Include(o => o.OrganizationCategory)
        .Include(o => o.EnterpriseGroupMember)
        .Include(o => o.MasterOrganization);

    if (_viewModel.Paging != false)
    {
        source = source
            .Skip(pageIndex * pageSize)
            .Take(pageSize);
    }

    //先具體化資料列：Razor 逐筆列舉 IQueryable 時 DataReader 仍開啟，
    //此時延遲載入 (Lazy Loading) 會在同一連線再發一次查詢，
    //導致「已經開啟與這個 Connection 建立關聯的 DataReader」例外。
    List<Organization> items = source.ToList();

}
@{
    int idx = 0;
}
@foreach (var item in items)
{
    idx++;
    <tr>
        <td>@(item.CompanyName)</td>
        <td>@(item.ReceiptNo)</td>
        <td>@(item.UndertakerName)</td>
        <td>@(item.ContactEmail)</td>
        <td>@(item.OrganizationStatus?.CurrentLevelNavigation?.Description)</td>
        <td>
            @{
                ViewBag.Index = idx;
                await Html.RenderPartialAsync("~/Views/OrganizationQuery/Module/ProcessCompanyItem.cshtml", item);
            }
        </td>
    </tr>
}




