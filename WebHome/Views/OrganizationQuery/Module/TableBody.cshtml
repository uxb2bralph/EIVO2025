@using System.IO
@using System.Linq.Expressions
@using WebHome.Helper
@using ModelCore.DataEntity
@using ModelCore.Locale
@using ModelCore.Models.ViewModel
@using Newtonsoft.Json
@using CommonLib.DataAccess
@{

    //DataItem 每一列會存取多個導覽屬性，先一次載入避免 N+1（須在 Skip/Take 之前）。
    _model = ((IQueryable<Organization>)this.Model).IncludeOrganizationListNavigations();
    _viewModel = ViewBag.ViewModel as OrganizationViewModel;

    _pageSize = _viewModel.PageSize ?? 10;
    _pageIndex = _viewModel.PageIndex ?? 0;

    if (_viewModel.SortType != null && _viewModel.SortType.Length > 0)
    {
        sorting();

        if (_order == null)
        {
            _items = _model.Skip(_pageIndex * _pageSize)
                .Take(_pageSize);
        }
        else
        {
            _items = _order.Skip(_pageIndex * _pageSize)
                .Take(_pageSize);
        }
    }
    else
    {
        _items = _model.OrderBy(t => t.ReceiptNo);
        _items = _items.Skip(_pageIndex * _pageSize)
            .Take(_pageSize);
    }
}

@{
    int idx = 0;
}
@foreach (var item in _items.ToList())
{
    idx++;
    await Html.RenderPartialAsync("~/Views/OrganizationQuery/Module/DataItem.cshtml", item);
}

@functions
{

    IQueryable<Organization> _items;
    IQueryable<Organization> _model;
    IQueryable<Organization> _order;
    OrganizationViewModel? _viewModel;
    int _pageSize;
    int _pageIndex;

    void sorting()
    {
        _order = _model;
        for (int i=0;i<_viewModel.SortType.Length;i++)
        {
            int idx = _viewModel.SortType[i].Value;
            switch (_viewModel.SortName[i])
            {
                case "營業人名稱":
                    _order = _order.OrderBy(i => i.CompanyName, idx);
                    break;
                case "統一編號":
                    _order = _order.OrderBy(i => i.ReceiptNo, idx);
                    break;
            }
        }
    }

}
