@using System.IO
@using System.Linq.Expressions
@using System.Threading.Tasks

@using WebHome.Models
@using WebHome.Helper
@using WebHome.Models.ViewModel
@using WebHome.Controllers

@using ModelCore.Helper
@using ModelCore.Locale
@using ModelCore.Models.ViewModel
@using ModelCore.DataEntity
@using ModelCore.Security.MembershipManagement
@using CommonLib.Core.Utility
@using CommonLib.Utility
@using Microsoft.AspNetCore.Mvc.ModelBinding
@using Microsoft.AspNetCore.Mvc.Razor
@using Microsoft.EntityFrameworkCore
@using WebHome.Infrastructure.BackgroundTasks

@functions
{
    //背景作業：由 BackgroundTaskService 於請求結束後執行。
    //使用者只以 uid/roleIndex 傳入，在此以自己的 ModelSource 重新載入，
    //不可沿用請求的 UserProfileWrapper（其實體由請求的 context 追蹤）。
    static void SaveAsERP(int taskID, String resultFile, InquireInvoiceViewModel viewModel, int? uid, int? roleIndex)
    {
            try
            {
                using (ModelSource db = new ModelSource())
                {
                    UserProfileWrapper? profile = db.ReloadProfile(uid, roleIndex);
                    IQueryable<InvoiceAllowance> items = db.GetTable<InvoiceAllowance>    ();
                    bool effective = false;
                    items = db.FilterAllowanceByRole(profile, items)
                .InquireAllowance(viewModel, db, ref effective)
                        //輸出每一列會用到的導覽屬性一次載入，避免逐筆 lazy loading。
                        .Include(a => a.InvoiceAllowanceSeller!).ThenInclude(s => s.Seller!).ThenInclude(o => o.OrganizationExtension)
                        .Include(a => a.InvoiceAllowanceDetails)
                        .Include(a => a.InvoiceAllowanceBuyer)
                        .Include(a => a.InvoiceAllowanceCancellation);

                    Exception exception = null;

                    try
                    {
                        String tmpPath = System.IO.Path.Combine(Logger.LogDailyPath, $"{Guid.NewGuid()}.tmp");
                        using (StreamWriter writer = new StreamWriter(tmpPath))
                        {
                            foreach (var item in items.ToList())
                            {
                                writer.WriteLine($"{item.InvoiceAllowanceSeller.Seller.OrganizationExtension?.CustomerNo,8}{item.AllowanceDate.Value.Year - 1911:0000}{item.AllowanceDate:MMdd}{item.InvoiceAllowanceDetails.FirstOrDefault()?.InvoiceNo}{(item.InvoiceAllowanceBuyer.IsB2C() ? "        " : item.InvoiceAllowanceBuyer.ReceiptNo)}{item.TotalAmount,8:########}{item.TaxAmount,8:########}{item.TotalAmount + item.TaxAmount,8:########}{(item.InvoiceAllowanceCancellation != null ? "Y" : " ")}");
                            }
                        }
                        File.Move(tmpPath, resultFile);
                    }
                    catch (Exception ex)
                    {
                        Logger.Error($"{ex}\r\n{items}");
                        exception = ex;
                    }

                    ProcessRequest taskItem = db.GetTable<ProcessRequest>()
                        .Where(t => t.TaskID == taskID).FirstOrDefault();

                    if (taskItem != null)
                    {
                        if (exception != null)
                        {
                            var logItem = new ExceptionLog
                            {
                                DataContent = exception.Message,
                                LogTime = DateTime.Now,
                            };
                            db.GetTable<ExceptionLog>
                            ().Add(logItem);
                            db.SubmitChanges();

                            taskItem.LogID = logItem.LogID;
                        }

                        taskItem.ProcessComplete = DateTime.Now;
                        db.SubmitChanges();
                    }
                }

            }
            catch (Exception ex)
            {
                Logger.Error(ex);
            }
    }

}
@{

    ModelSource<InvoiceItem> models;
    models = (ModelSource<InvoiceItem>)ViewContext.HttpContext.Items["Models"]!;

    InquireInvoiceViewModel _viewModel = new InquireInvoiceViewModel();
    _viewModel = await((SampleController<InvoiceItem>)ViewContext.HttpContext.Items["Controller"]).PrepareViewModelAsync<InquireInvoiceViewModel>();

    var profile = Context.GetUser();

    ProcessRequest processItem = new ProcessRequest
    {
        Sender = profile?.Entity.UID,
        SubmitDate = DateTime.Now,
        ProcessStart = DateTime.Now,
        ResponsePath = System.IO.Path.Combine(Logger.LogDailyPath, Guid.NewGuid().ToString() + ".txt"),
    };
    models.GetTable<ProcessRequest>().Add(processItem);
    models.SubmitChanges();

    int taskID = processItem.TaskID;
    String resultFile = processItem.ResponsePath;
    InquireInvoiceViewModel jobViewModel = _viewModel;
    var (jobUID, jobRoleIndex) = profile.ForBackgroundWork();
    Context.EnqueueBackgroundWork("AllowanceProcess/CreateCustomERPResult",
        _ => SaveAsERP(taskID, resultFile, jobViewModel, jobUID, jobRoleIndex));

    await Html.RenderPartialAsync("~/Views/Shared/Module/PromptCheckDownload.cshtml",
    new AttachmentViewModel
    {
        TaskID = processItem.TaskID,
        FileName = processItem.ResponsePath,
        FileDownloadName = "POSDISC.dat",
    });
}
