                @if(_profile.IsSystemAdmin())
                {
                    <button type="button" class="btn ml-2" name="btnNotifyWinning" onclick="uiInvoiceQuery.notify(true);">重送中獎通知</button>
                }
            </td>
        </tr>
    </table>



