
@using System.IO
@using System.Linq.Expressions
@using System.Threading.Tasks
@using System.Data
@using ClosedXML.Excel


@using WebHome.Helper
@using WebHome.Models
@using WebHome.Models.ViewModel
@using ModelCore.Models.ViewModel
@using WebHome.Controllers
@using ModelCore.DataEntity
@using ModelCore.Helper
@using ModelCore.Locale
@using ModelCore.Security.MembershipManagement
@using CommonLib.Core.Utility
@using CommonLib.Utility
@using Microsoft.AspNetCore.Mvc.ModelBinding
@using Microsoft.AspNetCore.Mvc.Razor

@using CommonLib.DataAccess
@using WebHome.Infrastructure.BackgroundTasks

@functions
{
    ModelSource<InvoiceItem>? models;
    IQueryable<WinningInvoiceReportItem>? _model;
    InquireInvoiceViewModel? _viewModel;
    UserProfileWrapper? profile;

    //背景作業：由 BackgroundTaskService 於請求結束後執行。
    //不可沿用請求的 models／_model／profile，改以 viewModel + uid/roleIndex 重建同一份查詢
    //（與 WinningInvoiceController.InquireWinningInvoice 共用 BuildWinningInvoiceReport）。
    static void SaveAsExcel(int taskID, String resultFile, InquireInvoiceViewModel viewModel, int? uid, int? roleIndex)
    {
            try
            {
                using (ModelSource<InvoiceItem> db = new ModelSource<InvoiceItem>())
                using (DataSet ds = new DataSet())
                {
                    UserProfileWrapper? profile = db.ReloadProfile(uid, roleIndex);
                    IQueryable<WinningInvoiceReportItem> _model =
                        WinningInvoiceController.BuildWinningInvoiceReport(db, viewModel, profile);

                    Exception? exception = null;

                    try
                    {
                        DataTable table = _model.ToDataTable();
                        table.TableName = "中獎統計";
                        table.Columns[0].ColumnName = "賣方統一編號";
                        table.Columns[1].ColumnName = "賣方名稱";
                        table.Columns[2].ColumnName = "賣方地址";
                        table.Columns[3].ColumnName = "中獎張數";
                        table.Columns[4].ColumnName = "捐贈張數";
                        ds.Tables.Add(table);

                        using (XLWorkbook xls = ds.ConvertToExcel())
                        {
                            xls.SaveAs(resultFile);
                        }
                    }
                    catch (Exception ex)
                    {
                        Logger.Error($"{ex}\r\n{_model}");
                        exception = ex;
                    }

                    ProcessRequest? taskItem = db.GetTable<ProcessRequest>()
                        .Where(t => t.TaskID == taskID).FirstOrDefault();

                    if (taskItem != null)
                    {
                        if (exception != null)
                        {
                            var logItem = new ExceptionLog
                            {
                                DataContent = exception.Message,
                                LogTime = DateTime.Now,
                            };
                            db.GetTable<ExceptionLog>
                                ().Add(logItem);
                            db.SubmitChanges();

                            taskItem.LogID = logItem.LogID;
                        }

                        taskItem.ProcessComplete = DateTime.Now;
                        db.SubmitChanges();
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.Error(ex);
            }
    }

}
@{

    models = (ModelSource<InvoiceItem>)ViewContext.HttpContext.Items["Models"]!;

    _viewModel = (InquireInvoiceViewModel)ViewBag.ViewModel;

    _model = (IQueryable<WinningInvoiceReportItem>)this.Model;
    profile = Context.GetUser();

}
@{
    ProcessRequest processItem = new ProcessRequest
    {
        Sender = profile?.Entity.UID,
        SubmitDate = DateTime.Now,
        ProcessStart = DateTime.Now,
        ResponsePath = System.IO.Path.Combine(Logger.LogDailyPath, Guid.NewGuid().ToString() + ".xlsx"),
    };

    models.GetTable<ProcessRequest>().Add(processItem);
    models.SubmitChanges();

    int taskID = processItem.TaskID;
    String resultFile = processItem.ResponsePath;
    InquireInvoiceViewModel jobViewModel = _viewModel;
    var (jobUID, jobRoleIndex) = profile.ForBackgroundWork();
    Context.EnqueueBackgroundWork("WinningInvoice/CreateXlsx",
        _ => SaveAsExcel(taskID, resultFile, jobViewModel, jobUID, jobRoleIndex));

    await Html.RenderPartialAsync("~/Views/Shared/Module/PromptCheckDownload.cshtml",
        new AttachmentViewModel
        {
            TaskID = processItem.TaskID,
            FileName = processItem.ResponsePath,
            FileDownloadName = $"中獎統計表({DateTime.Today:yyyy-MM-dd}).xlsx",
        });
}





