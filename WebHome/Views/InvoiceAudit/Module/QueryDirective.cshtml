        <input type="radio" name="DocType" value="@((int)Naming.DocumentTypeDefinition.E_Invoice)" checked="@(_viewModel.DocType == Naming.DocumentTypeDefinition.E_Allowance)" onchange="window.location.href='@Html.Raw(Url.Action("AllowanceIndex","InvoiceAudit"))';" />折讓單
