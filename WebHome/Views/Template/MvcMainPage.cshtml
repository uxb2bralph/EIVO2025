@using System.IO
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Mvc

@using ModelCore.DataEntity
@using WebHome.Controllers
@using WebHome.Helper
@using ModelCore.Locale
@{
    ViewBag.Title = "電子發票系統";
    ModelSource<InvoiceItem> models = (ModelSource<InvoiceItem>)ViewContext.HttpContext.Items["Models"]!;

    UserProfileWrapper _userProfile;
    IQueryable<SystemMessage> _items;
    _userProfile = Context.GetUser();
    _items = models.GetTable<SystemMessage>().Where(s => s.AlwaysShow || (s.StartDate <= DateTime.Now && s.EndDate.Value.AddDays(1) > DateTime.Now));

    var _notices = _items.ToList();
    var _noticeText = String.Join("　", _notices.Select(n => n.MessageContents));
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <title>電子發票系統</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    @* BS5.3（含品牌令牌）→ FontAwesome 6 → jQuery UI → 舊版頁面樣式 *@
    <link href="~/css/site.css" rel="stylesheet" type="text/css" />
    <link href="~/vendor/fontawesome/css/all.min.css" rel="stylesheet" type="text/css" />
    <link href="~/vendor/fontawesome/css/v4-shims.min.css" rel="stylesheet" type="text/css" />
    <link href="~/vendor/jquery-ui/jquery-ui.min.css" rel="stylesheet" type="text/css" />
    <link href="~/css/rwd-table.min.css" rel="stylesheet" type="text/css" />
    @* 以下為既有頁面內容樣式，須後於 site.css 載入以保留原有視覺 *@
    <link href="~/App_Themes/Visitor/body.css" rel="stylesheet" />
    <link href="~/App_Themes/Visitor/content.css" rel="stylesheet" />
    <link href="~/App_Themes/Visitor/paper.css" rel="stylesheet" />
    <link href="~/App_Themes/Visitor/StyleSheet.css" rel="stylesheet" />
    <link href="~/App_Themes/Visitor/table.css" rel="stylesheet" />
    <link href="~/css/eivo.css" rel="stylesheet" type="text/css" />

    @{
        await Html.RenderPartialAsync("~/Views/Shared/CommonScriptInclude.cshtml");
    }
    @RenderSection("headContent", false)
</head>
<body class="eivo-shell">

    <!-- Topbar -->
    <header class="eivo-topbar navbar navbar-expand-lg sticky-top">
        <div class="container-fluid">
            <button type="button" class="navbar-toggler d-lg-none me-2"
                    data-bs-toggle="offcanvas" data-bs-target="#eivoSidebar" aria-controls="eivoSidebar"
                    aria-label="切換功能選單">
                <span class="navbar-toggler-icon"></span>
            </button>

            <a class="navbar-brand" href="@(Url.Action("MainPage","Home"))">電子發票系統</a>

            @if (_notices.Count > 0)
            {
                <div class="eivo-topbar-notice" title="@_noticeText">
                    <i class="fa-solid fa-bullhorn me-1" aria-hidden="true"></i>系統公告：@_noticeText
                </div>
            }

            <ul class="navbar-nav flex-row ms-auto">
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button"
                       data-bs-toggle="dropdown" aria-expanded="false" aria-label="通知">
                        <i class="fa-solid fa-bell fa-fw" aria-hidden="true"></i>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" href="@(Url.Action("QueryIndex","ProcessRequest"))">
                                <i class="fa-solid fa-list-check fa-fw me-2" aria-hidden="true"></i>工作清單
                            </a>
                        </li>
                    </ul>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button"
                       data-bs-toggle="dropdown" aria-expanded="false" aria-label="帳號">
                        <i class="fa-solid fa-user fa-fw" aria-hidden="true"></i>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        @if (_userProfile.CurrentUserRole?.RoleID != (int)Naming.RoleID.資料稽核員)
                        {
                            <li>
                                <a class="dropdown-item" href="@(Url.Content("~/UserProfile/EditMySelf"))">
                                    <i class="fa-solid fa-user fa-fw me-2" aria-hidden="true"></i>帳號管理
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                        }
                        <li>
                            <a class="dropdown-item" href="@(Url.Action("Login","Account"))">
                                <i class="fa-solid fa-right-from-bracket fa-fw me-2" aria-hidden="true"></i>登出
                            </a>
                        </li>
                    </ul>
                </li>
            </ul>
        </div>
    </header>

    <div class="eivo-shell-body">

        <!-- Sidebar：lg 以上常駐，以下由 topbar hamburger 開啟 -->
        <nav id="eivoSidebar" class="eivo-sidebar offcanvas-lg offcanvas-start"
             tabindex="-1" aria-label="功能選單">
            <div class="offcanvas-header d-lg-none">
                <h5 class="offcanvas-title">功能選單</h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas"
                        data-bs-target="#eivoSidebar" aria-label="關閉"></button>
            </div>
            <div class="offcanvas-body p-0">
                @{ await Html.RenderPartialAsync("~/Views/SiteAction/PageMenuBar.cshtml"); }
            </div>
        </nav>

        <!-- 內容區 -->
        <main class="eivo-main">
            <ul class="nav nav-tabs" role="tablist" id="masterTab">
                <li class="nav-item d-flex align-items-center" role="presentation">
                    <a href="#masterHome" class="nav-link tab-link active" aria-controls="masterHome"
                       role="tab" data-bs-toggle="tab" title="@(ViewBag.ActionName ?? "首頁")">
                        <span class="eivo-tab-text">@(ViewBag.ActionName ?? "首頁")</span>
                    </a>
                </li>
            </ul>

            <div class="tab-content" id="masterTabContent">
                <div role="tabpanel" class="tab-pane fade show active" id="masterHome">
                    <div class="container-fluid">
                        <form id="theForm" method="post" role="form" enctype="multipart/form-data">
                            @RenderSection("formContent", false)
                        </form>
                        <div class="row">
                            @RenderBody()
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <footer class="eivo-footer">Powered by UXB2B</footer>

</body>
</html>
@{ await Html.RenderPartialAsync("~/Views/Shared/GlobalScript.cshtml");}
@{ await Html.RenderPartialAsync("~/Views/Shared/AlertMessage.cshtml");}
@{ await Html.RenderPartialAsync("~/Views/Shared/ReportInputError.cshtml");}
