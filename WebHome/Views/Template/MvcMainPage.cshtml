@using System.IO
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Mvc

@using ModelCore.DataEntity
@using WebHome.Controllers
@using WebHome.Helper
@using ModelCore.Locale
@{
    ViewBag.Title = "電子發票系統";
    ModelSource<InvoiceItem> models = (ModelSource<InvoiceItem>)ViewContext.HttpContext.Items["Models"]!;

    UserProfileWrapper _userProfile;
    IQueryable<SystemMessage> _items;
    _userProfile = Context.GetUser();
    _items = models.GetTable<SystemMessage>().Where(s => s.AlwaysShow || (s.StartDate <= DateTime.Now && s.EndDate.Value.AddDays(1) > DateTime.Now));
}
<!DOCTYPE html>
<html lang="zh-tw">
<head>
    <title>電子發票系統</title>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="" />
    <meta name="author" content="" />

    <!-- Legacy content styles (Bootstrap 3 + jQuery UI + page widgets).
         Loaded first so the new admin layout below can override layout parts. -->
    <link href="~/Content/eivo-bootstrap.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/bootstrap-theme.css" rel="stylesheet" type="text/css" />
    <link href="~/css/rwd-table.min.css" rel="stylesheet" type="text/css" />
    <link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/App_Themes/Visitor/jquery-ui-1.8.14.custom.css" rel="stylesheet" />
    <link href="~/App_Themes/Visitor/body.css" rel="stylesheet" />
    <link href="~/App_Themes/Visitor/content.css" rel="stylesheet" />
    <link href="~/App_Themes/Visitor/header.css" rel="stylesheet" />
    <link href="~/App_Themes/Visitor/left-menu.css" rel="stylesheet" />
    <link href="~/App_Themes/Visitor/paper.css" rel="stylesheet" />
    <link href="~/App_Themes/Visitor/StyleSheet.css" rel="stylesheet" />
    <link href="~/App_Themes/Visitor/table.css" rel="stylesheet" />
    <link href="~/css/eivo.css" rel="stylesheet" type="text/css" />

    <!-- New admin layout: Tabler Icons + Vuetify 3 base component styles -->
    <link href="https://cdn.jsdelivr.net/npm/@@tabler/icons@3.1.0/dist/tabler-icons.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/vuetify@3.6.11/dist/vuetify.min.css" rel="stylesheet" />

    <!-- Theme variables + layout skeleton + legacy DOM adapter (wins over legacy) -->
    <link href="~/css/vuetify-theme.css" rel="stylesheet" type="text/css" />
    <link href="~/css/layout.css" rel="stylesheet" type="text/css" />
    <link href="~/css/layout-adapter.css" rel="stylesheet" type="text/css" />

    <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
        <script src="https://oss.maxcdn.com/libs/html5shiv/3.7.0/html5shiv.js"></script>
        <script src="https://oss.maxcdn.com/libs/respond.js/1.4.2/respond.min.js"></script>
    <![endif]-->
    @{
        await Html.RenderPartialAsync("~/Views/Shared/CommonScriptInclude.cshtml");
        //await Html.RenderPartialAsync("~/Views/Shared/JsGrid.ascx");
    }
    @RenderSection("headContent", false)

</head>
<body class="skin--default">

    <div class="layout-wrapper layout-nav-type-vertical layout-navbar-sticky layout-content-width-boxed">

        <!-- Mobile overlay (shown when the drawer is open on small screens) -->
        <div class="layout-overlay"></div>

        <!-- 👉 Vertical sidebar -->
        <div class="vertical-nav-wrapper">
            <aside class="layout-vertical-nav">
                <!-- Header / logo -->
                <div class="nav-header">
                    <a class="app-logo app-title-wrapper" href="../Home/MainPage">
                        <img class="app-logo-img" alt="" src="data:image/svg+xml;base64," />
                        <h1 class="app-logo-title">電子發票系統</h1>
                    </a>
                    <!-- Collapse / pin toggle (desktop) -->
                    <div class="header-action">
                        <i class="tabler-circle-dot v-icon nav-pin" role="button" tabindex="0" aria-label="收合選單"></i>
                    </div>
                </div>

                <!-- Menu items (rendered by the role-specific menu partial,
                     then restructured into .nav-items by layout.js) -->
                @{ await Html.RenderPartialAsync("~/Views/SiteAction/PageMenuBar.cshtml"); }
            </aside>
        </div>

        <!-- 👉 Content wrapper -->
        <div class="layout-content-wrapper">

            <!-- Top navbar (rounded pill) -->
            <header class="layout-navbar navbar-blur">
                <div class="navbar-content-container">
                    <!-- Mobile hamburger -->
                    <button type="button" class="v-btn v-btn--icon d-lg-none" id="vertical-nav-toggle-btn" aria-label="選單">
                        <i class="tabler-menu-2 v-icon" aria-hidden="true"></i>
                    </button>

                    <!-- System announcements (marquee) -->
                    @if (_items.Count() > 0)
                    {
                        <div class="search-trigger" title="系統公告">
                            <i class="tabler-bell v-icon" aria-hidden="true"></i>
                            <span class="d-none d-md-inline">
                                <marquee class="notice" scrollamount="2" style="max-width: 320px; display: inline-block;">
                                    @foreach (var item in _items.ToList())
                                    {
                                        @item.MessageContents
                                    }
                                </marquee>
                            </span>
                        </div>
                    }

                    <div class="v-spacer"></div>

                    <!-- Language -->
                    <button type="button" class="v-btn v-btn--icon" title="語言">
                        <i class="tabler-language v-icon" aria-hidden="true"></i>
                    </button>

                    <!-- Theme toggle -->
                    <button type="button" class="v-btn v-btn--icon" data-theme-toggle title="切換主題">
                        <i class="tabler-moon-stars v-icon" aria-hidden="true"></i>
                    </button>

                    <!-- Work list / alerts -->
                    <button type="button" class="v-btn v-btn--icon" title="工作清單" onclick="location.href='@(Url.Action("QueryIndex","ProcessRequest"))'">
                        <i class="tabler-list-check v-icon" aria-hidden="true"></i>
                    </button>

                    <!-- User menu -->
                    <div class="user-avatar" title="帳號管理 / 登出" onclick="location.href='@(VirtualPathUtility.ToAbsolute("~/UserProfile/EditMySelf"))'">
                        <i class="tabler-user v-icon" aria-hidden="true"></i>
                        <span class="badge-dot"></span>
                    </div>
                </div>
            </header>

            <!-- Page content -->
            <main class="layout-page-content">
                <div class="page-content-container">

                    <ul class="nav nav-tabs" role="tablist" id="masterTab">
                        <li role="presentation" class="active">
                            <a href="#masterHome" class="tab-link" aria-controls="masterHome" role="tab" data-toggle="tab">@(ViewBag.ActionName ?? "首頁") <i class="fa fa-angle-double-right" aria-hidden="true"></i></a>
                        </li>
                    </ul>

                    <!-- Tab panes -->
                    <div class="tab-content" id="masterTabContent">
                        <div role="tabpanel" class="tab-pane active" id="masterHome">
                            <div class="container-fluid legacy-surface">
                                <form id="theForm" method="post" role="form" enctype="multipart/form-data">
                                    @RenderSection("formContent", false)
                                </form>
                                <div class="row">
                                    @RenderBody()
                                </div>
                                <!-- /.row -->
                            </div>
                        </div>
                    </div>

                </div>
            </main>

            <!-- Footer -->
            <footer class="layout-footer">
                <div class="footer-content-container">
                    <span>電子發票系統</span>
                    <span class="copyright">Powered by UXB2B</span>
                </div>
            </footer>

        </div>
        <!-- /.layout-content-wrapper -->
    </div>
    <!-- /.layout-wrapper -->

    <!-- Layout interactions (menu restructure, collapse, accordion, theme) -->
    <script src="~/js/layout.js"></script>

</body>
</html>
@{ await Html.RenderPartialAsync("~/Views/Shared/GlobalScript.cshtml");}
@{ await Html.RenderPartialAsync("~/Views/Shared/AlertMessage.cshtml");}
@{ await Html.RenderPartialAsync("~/Views/Shared/ReportInputError.cshtml");}
