<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.SpaServices.Extensions" Version="10.0.5" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.5" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.4.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.5" />
    <!--
      Pin the whole Microsoft.IdentityModel.* family to one coherent version. Transitive
      resolution otherwise leaves JsonWebTokens / System.IdentityModel.Tokens.Jwt / Protocols.*
      at 8.0.1 while Tokens/Logging/Xml resolve to 8.14.0. The mismatch makes the JWT bearer
      handler throw MissingMethodException (Base64UrlEncoder.Decode) on every token read, so
      every [Authorize] request returns 401.
    -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.14.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols" Version="8.14.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApplicationResource\ApplicationResource.csproj" />
    <ProjectReference Include="..\Business.EF\Business.EF.csproj" />
    <ProjectReference Include="..\CommonLib.Core\CommonLib.Core.csproj" />
    <ProjectReference Include="..\ModelExtension.EF\ModelExtension.EF.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Core\Mapping\" />
  </ItemGroup>

</Project>
